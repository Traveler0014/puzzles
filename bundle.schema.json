{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://healthy-life/prompt-bundle.schema.json",
  "title": "PromptBundle（题目包）契约",
  "description": "与 packages/prompts/src/types.ts 的 validateBundle 一一对应；跨字段规则（category 引用、id 唯一、semver）由脚本额外校验。schemaVersion = 1。",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version", "updatedAt", "status", "categories", "prompts"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "published"] },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "prompts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "question", "answer", "source"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "answer": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "source": { "type": "string", "minLength": 1, "maxLength": 300 },
          "sourceUrl": { "type": "string", "maxLength": 1000 },
          "author": { "type": "string", "maxLength": 100 },
          "difficulty": { "enum": [1, 2, 3] }
        }
      }
    }
  }
}
